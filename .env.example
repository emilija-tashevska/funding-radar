# Claude — extraction (Sonnet) and scoring (Opus)
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-sonnet-5
SCORE_MODEL=claude-opus-5

# Telegram digest (same bot as the job agent is fine)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: UK Companies House verification (free key)
COMPANIES_HOUSE_KEY=

# Optional: encrypt the published site behind a passphrase. Unset = published in the clear.
SITE_PASSPHRASE=

DATABASE_PATH=data/funding.db
LOG_LEVEL=INFO
# Hard ceiling on extraction calls per run, so a source spike cannot run up a bill
MAX_EXTRACTIONS_PER_RUN=250
